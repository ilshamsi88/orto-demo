# ---------------------------------------------------------------------------
# WhatsApp booking notification
# ---------------------------------------------------------------------------
# link      = opens WhatsApp pre-filled with the booking; one tap to send. No cost,
#             no API account. This is the default and what the demo ships with.
# api       = fully automatic send via api/notify-whatsapp.js (needs credentials below).
# simulated = sends nothing, just shows the exact message on the confirmation screen.
VITE_WHATSAPP_MODE=link

# Owner's WhatsApp number in full international format, digits only.
# Example for UAE: 971501234567
VITE_OWNER_WHATSAPP=

# Only used when VITE_WHATSAPP_MODE=api
VITE_NOTIFY_ENDPOINT=/api/notify-whatsapp

# ---------------------------------------------------------------------------
# Server-side only (never exposed to the browser) — required for mode=api
# ---------------------------------------------------------------------------
# WHATSAPP_PROVIDER=cloud
# OWNER_WHATSAPP=971501234567
#
# Meta WhatsApp Cloud API
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
#
# Twilio
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
